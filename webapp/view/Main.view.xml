<mvc:View
	controllerName="com.cfa.charlist.controller.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:table="sap.ui.table"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false" fitContent="true">

		<!-- Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H2" />
				</f:heading>
				<f:expandedContent>
					<Label text="{i18n>appSubtitle}" />
				</f:expandedContent>
				<f:actions>
					<SegmentedButton selectedKey="{ui>/viewMode}" enabled="{= !${ui>/multiClass} }">
						<items>
							<SegmentedButtonItem key="table" icon="sap-icon://table-view" tooltip="{i18n>tableView}" />
							<SegmentedButtonItem key="list" icon="sap-icon://list" tooltip="{i18n>listView}" />
						</items>
					</SegmentedButton>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<!-- Filter bar lives in the page header -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<fb:FilterBar
					id="filterbar"
					useToolbar="false"
					showFilterConfiguration="false"
					showRestoreButton="false"
					showClearButton="true"
					showGoOnFB="true"
					showClearOnFB="true"
					search="onGoPress"
					clear="onClearPress">
					<fb:filterGroupItems>
						<fb:FilterGroupItem name="classType" label="{i18n>filterClassType}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<Select
									id="classTypeSelect"
									selectedKey="{ui>/classType}"
									change="onClassTypeChange"
									forceSelection="true"
									width="100%">
									<core:Item key="002" text="{i18n>classType002}" />
									<core:Item key="003" text="{i18n>classType003}" />
								</Select>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="class" label="{i18n>filterClass}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="classSelect"
									selectedKeys="{ui>/classIds}"
									enabled="{ui>/classSelectEnabled}"
									busy="{ui>/classBusy}"
									busyIndicatorDelay="0"
									placeholder="{i18n>classPlaceholder}"
									width="100%"
									selectionChange="onClassChange"
									items="{ path: 'ui>/classes', templateShareable: false }">
									<core:Item key="{ui>ClassInternalID}" text="{ui>__display}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="object" label="{i18n>filterObjectSearch}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiInput
									id="objectSearch"
									width="100%"
									placeholder="{i18n>objectSearchPlaceholder}"
									showValueHelp="true"
									valueHelpRequest="onObjectValueHelp" />
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charc" label="{i18n>filterCharc}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="charcSelect"
									width="100%"
									placeholder="{i18n>charcPlaceholder}"
									items="{ path: 'ui>/charcOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charcValue" label="{i18n>filterCharcValue}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiInput
									id="charcValueSearch"
									width="100%"
									placeholder="{i18n>charcValuePlaceholder}"
									showValueHelp="true"
									valueHelpRequest="onCharcValueValueHelp" />
							</fb:control>
						</fb:FilterGroupItem>
					</fb:filterGroupItems>
				</fb:FilterBar>
			</f:DynamicPageHeader>
		</f:header>

		<!-- Main content -->
		<f:content>
			<FlexBox direction="Column" fitContainer="true" renderType="Bare" width="100%" height="100%">

				<MessageStrip
					id="errorStrip"
					text="{ui>/errorText}"
					type="Error"
					showIcon="true"
					showCloseButton="true"
					visible="{ui>/errorVisible}"
					class="sapUiSmallMarginBottom" />

				<!-- Empty state shown before the first Go -->
				<IllustratedMessage
					id="emptyState"
					visible="{ui>/showEmptyState}"
					illustrationType="sapIllus-Tent"
					title="{i18n>emptyStateTitle}"
					description="{i18n>emptyStateDesc}" />

				<!-- No-results state shown after a Go that returned nothing -->
				<IllustratedMessage
					id="noDataState"
					visible="{ui>/showNoData}"
					illustrationType="sapIllus-NoSearchResults"
					title="{ui>/noDataTitle}"
					description="{i18n>noDataDesc}" />

				<!-- Shared toolbar for both views -->
				<OverflowToolbar visible="{ui>/showTable}">
					<Title id="tableTitle" text="{ui>/tableTitle}" level="H3" />
					<Button id="prevPage" icon="sap-icon://navigation-left-arrow" tooltip="{i18n>prevPageButton}" enabled="{ui>/pagePrevEnabled}" press="onPrevPage" />
					<Text id="pageInfo" text="{ui>/pageInfo}" />
					<Button id="nextPage" icon="sap-icon://navigation-right-arrow" tooltip="{i18n>nextPageButton}" enabled="{ui>/pageNextEnabled}" press="onNextPage" />
					<Select id="pageSizeSelect" selectedKey="{ui>/pageSize}" forceSelection="true" autoAdjustWidth="true" tooltip="{i18n>rowsPerPage}" change="onPageSizeChange">
						<core:Item key="25" text="25" />
						<core:Item key="50" text="50" />
						<core:Item key="100" text="100" />
					</Select>
					<ToolbarSpacer />
					<Switch id="showEmptySwitch" state="{ui>/showEmpty}" visible="{= ${ui>/viewMode} === 'list' }" />
					<Label text="{i18n>showEmpty}" visible="{= ${ui>/viewMode} === 'list' }" />
					<SearchField id="resultSearch" width="16rem" placeholder="{i18n>resultSearchPlaceholder}" search="onResultSearch" liveChange="onResultSearch" visible="{= ${ui>/viewMode} === 'table' }" />
					<Button id="sortBtn" icon="sap-icon://sort" text="{i18n>sortButton}" tooltip="{i18n>sortButton}" press="onSortPress" />
					<Button id="exportBtn" icon="sap-icon://excel-attachment" text="{i18n>exportButton}" tooltip="{i18n>exportButton}" press="onExport" />
				</OverflowToolbar>

				<!-- TABLE VIEW -->
				<table:Table
					id="resultTable"
					visible="{= ${ui>/showTable} &amp;&amp; ${ui>/viewMode} === 'table' }"
					rows="{ path: 'ui>/rows', templateShareable: false }"
					selectionMode="None"
					selectionBehavior="RowOnly"
					enableColumnReordering="true"
					enableColumnFreeze="true"
					showColumnVisibilityMenu="true"
					columnHeaderHeight="44"
					rowHeight="32"
					visibleRowCountMode="Auto"
					minAutoRowCount="5"
					busy="{ui>/tableBusy}"
					busyIndicatorDelay="0"
					sort="onColumnSort">
					<table:layoutData>
						<FlexItemData growFactor="1" />
					</table:layoutData>
					<!-- Columns are generated dynamically in Main.controller.js::_buildColumns -->
				</table:Table>

				<!-- LIST / CARD VIEW -->
				<ScrollContainer
					id="listView"
					visible="{= ${ui>/showTable} &amp;&amp; ${ui>/viewMode} === 'list' }"
					vertical="true"
					horizontal="false"
					height="100%"
					width="100%"
					busy="{ui>/tableBusy}"
					busyIndicatorDelay="0">
					<layoutData>
						<FlexItemData growFactor="1" />
					</layoutData>
					<OverflowToolbar class="sapUiTinyMarginBottom">
							<Label text="{i18n>sortBy}" />
							<HBox items="{ path: 'ui>/sortFields', templateShareable: false }">
								<Button text="{ui>label}" press="onSortFieldPress" type="{= ${ui>key} === ${ui>/sortField} ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>key} === ${ui>/sortField} ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" class="sapUiTinyMarginEnd" />
							</HBox>
						</OverflowToolbar>
						<VBox items="{ path: 'ui>/listRows', templateShareable: false }">
						<Panel class="cfaCard sapUiSmallMarginTop sapUiSmallMarginBegin sapUiSmallMarginEnd" backgroundDesign="Solid">
							<HBox wrap="Wrap" alignItems="Start">
								<!-- left: object master -->
								<VBox width="15rem" class="sapUiSmallMargin cfaCardMaster">
									<Label text="{i18n>colEquipment}" class="cfaMutedLabel" />
									<Title text="{ui>objNumber}" level="H3" wrapping="true" />
									<Text text="{ui>objDesc}" class="sapUiTinyMarginTop" />
									<ObjectStatus text="{ui>objClass}" icon="sap-icon://tag" state="Information" inverted="true" class="sapUiTinyMarginTop" />
									<VBox items="{ path: 'ui>masterFields', templateShareable: false }">
										<VBox class="sapUiTinyMarginTop">
											<Label text="{ui>label}" class="cfaMutedLabel" />
											<Text text="{ui>value}" />
										</VBox>
									</VBox>
								</VBox>
								<!-- right: grouped characteristics -->
								<VBox class="sapUiSmallMargin cfaCardGroups" items="{ path: 'ui>groups', templateShareable: false }">
									<VBox class="sapUiSmallMarginBottom" visible="{= ${ui>populated} &gt; 0 || ${ui>/showEmpty} }">
										<HBox alignItems="Center" class="cfaGroupHeader">
											<core:Icon src="sap-icon://circle-task-2" size="0.55rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
											<Title text="{ui>name}" level="H6" />
											<Text text="{ui>countText}" class="cfaMutedLabel sapUiTinyMarginBegin" />
										</HBox>
										<HBox wrap="Wrap" items="{ path: 'ui>charcs', templateShareable: false }">
											<VBox width="13rem" class="sapUiTinyMarginTop sapUiMediumMarginEnd" visible="{= ${ui>populated} || ${ui>/showEmpty} }">
												<Label text="{ui>label}" class="cfaMutedLabel" />
												<HBox alignItems="End">
													<Text text="{ui>value}" />
													<Text text="{ui>unit}" class="cfaMutedLabel sapUiTinyMarginBegin" visible="{= !!${ui>unit} }" />
												</HBox>
											</VBox>
										</HBox>
									</VBox>
								</VBox>
							</HBox>
						</Panel>
					</VBox>
				</ScrollContainer>

			</FlexBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
