<mvc:View
	controllerName="com.cfa.charlist.controller.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:table="sap.ui.table"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false" fitContent="true">

		<!-- Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H2" />
				</f:heading>
				<f:expandedContent>
					<Label text="{i18n>appSubtitle}" />
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<!-- Filter bar lives in the page header -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<fb:FilterBar
					id="filterbar"
					useToolbar="false"
					showFilterConfiguration="false"
					showRestoreButton="false"
					showClearButton="true"
					showGoOnFB="true"
					showClearOnFB="true"
					search="onGoPress"
					clear="onClearPress">
					<fb:filterGroupItems>
						<fb:FilterGroupItem name="classType" label="{i18n>filterClassType}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<Select
									id="classTypeSelect"
									selectedKey="{ui>/classType}"
									change="onClassTypeChange"
									forceSelection="true"
									width="100%">
									<core:Item key="002" text="{i18n>classType002}" />
									<core:Item key="003" text="{i18n>classType003}" />
								</Select>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="class" label="{i18n>filterClass}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<ComboBox
									id="classSelect"
									selectedKey="{ui>/classId}"
									enabled="{ui>/classSelectEnabled}"
									busy="{ui>/classBusy}"
									busyIndicatorDelay="0"
									placeholder="{i18n>classPlaceholder}"
									width="100%"
									items="{ path: 'ui>/classes', templateShareable: false }">
									<core:ListItem key="{ui>ClassInternalID}" text="{ui>__display}" additionalText="{ui>ClassGroup}" />
								</ComboBox>
							</fb:control>
						</fb:FilterGroupItem>
					</fb:filterGroupItems>
				</fb:FilterBar>
			</f:DynamicPageHeader>
		</f:header>

		<!-- Main content -->
		<f:content>
			<FlexBox direction="Column" fitContainer="true" renderType="Bare" width="100%" height="100%">

				<MessageStrip
					id="errorStrip"
					text="{ui>/errorText}"
					type="Error"
					showIcon="true"
					showCloseButton="true"
					visible="{ui>/errorVisible}"
					class="sapUiSmallMarginBottom" />

				<!-- Empty state shown before the first Go -->
				<IllustratedMessage
					id="emptyState"
					visible="{ui>/showEmptyState}"
					illustrationType="sapIllus-Tent"
					title="{i18n>emptyStateTitle}"
					description="{i18n>emptyStateDesc}" />

				<!-- No-results state shown after a Go that returned nothing -->
				<IllustratedMessage
					id="noDataState"
					visible="{ui>/showNoData}"
					illustrationType="sapIllus-NoSearchResults"
					title="{ui>/noDataTitle}"
					description="{i18n>noDataDesc}" />

				<table:Table
					id="resultTable"
					visible="{ui>/showTable}"
					rows="{ path: 'ui>/rows', templateShareable: false }"
					selectionMode="None"
					selectionBehavior="RowOnly"
					enableColumnReordering="true"
					enableColumnFreeze="true"
					showColumnVisibilityMenu="true"
					columnHeaderHeight="44"
					rowHeight="32"
					visibleRowCountMode="Auto"
					minAutoRowCount="5"
					busy="{ui>/tableBusy}"
					busyIndicatorDelay="0"
					sort="onColumnSort">
					<table:layoutData>
						<FlexItemData growFactor="1" />
					</table:layoutData>
					<table:extension>
						<OverflowToolbar>
							<Title id="tableTitle" text="{ui>/tableTitle}" level="H3" />
							<ToolbarSpacer />
							<Button
								id="exportBtn"
								icon="sap-icon://excel-attachment"
								text="{i18n>exportButton}"
								tooltip="{i18n>exportButton}"
								enabled="{ui>/showTable}"
								press="onExport" />
						</OverflowToolbar>
					</table:extension>
					<!-- Columns are generated dynamically in Main.controller.js::_buildColumns -->
				</table:Table>

			</FlexBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
