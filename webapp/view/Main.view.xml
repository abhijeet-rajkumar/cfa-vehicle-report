<mvc:View
	controllerName="com.cfa.vehiclelist.controller.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:table="sap.ui.table"
	xmlns:core="sap.ui.core"
	xmlns:custom="com.cfa.vehiclelist.control"
	height="100%">

	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false">

		<!-- Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H2" />
				</f:heading>
				<f:expandedContent>
					<Label text="{i18n>appSubtitle}" />
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<!-- Filter bar lives in the page header -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<Panel
					id="filterSection"
					headerText="{i18n>filterSectionTitle}"
					expandable="true"
					expanded="true"
					width="100%">
					<fb:FilterBar
						id="filterbar"
						useToolbar="false"
						showFilterConfiguration="false"
						showRestoreButton="false"
						showClearButton="true"
						showGoOnFB="true"
						showClearOnFB="true"
						search="onGoPress"
						clear="onClearPress">
					<fb:filterGroupItems>
						<fb:FilterGroupItem name="class" label="{i18n>filterClass}" groupName="main" visibleInFilterBar="true" mandatory="true">
							<fb:control>
								<Select
									id="classSelect"
									selectedKey="{ui>/classId}"
									enabled="{ui>/classSelectEnabled}"
									busy="{ui>/classBusy}"
									busyIndicatorDelay="0"
									forceSelection="false"
									change="onClassChange"
									placeholder="{i18n>classPlaceholder}"
									width="100%"
									items="{ path: 'ui>/classes', templateShareable: false }">
									<core:Item key="{ui>ClassInternalID}" text="{ui>__display}" />
								</Select>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charc" label="{i18n>filterSubClassCharc}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="charcSelect"
									width="100%"
									placeholder="{i18n>subClassCharcPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									selectionChange="onSubClassChange"
									items="{ path: 'ui>/charcOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charcValue" label="{i18n>filterSubClassValue}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="charcValueFilter"
									width="100%"
									busy="{ui>/charcValueBusy}"
									busyIndicatorDelay="0"
									placeholder="{i18n>subClassValuePlaceholder}"
									items="{ path: 'ui>/charcValueOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="cabinConfiguration" label="{i18n>filterCabinConfig}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="cabinConfigFilter"
									placeholder="{i18n>cabinConfigPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									width="100%"
									items="{ path: 'ui>/cabinConfigOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="equipmentOwnedBy" label="{i18n>filterOwnedBy}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="equipmentOwnedByFilter"
									placeholder="{i18n>ownedByPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									width="100%"
									items="{ path: 'ui>/equipmentOwnedByOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="vehicleAge" label="{i18n>filterVehicleAge}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<HBox alignItems="Center" width="100%">
									<Input
										id="vehicleAgeFrom"
										type="Number"
										placeholder="{i18n>vehicleAgeFromPlaceholder}"
										width="100%">
						<layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
					</Input>
									<Text text="-" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
									<Input
										id="vehicleAgeTo"
										type="Number"
										placeholder="{i18n>vehicleAgeToPlaceholder}"
										width="100%">
						<layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
					</Input>
								</HBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="odometer" label="{i18n>filterOdometerKms}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<HBox alignItems="Center" width="100%">
									<Input
										id="odometerFrom"
										type="Number"
										placeholder="{i18n>vehicleAgeFromPlaceholder}"
										width="100%">
						<layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
					</Input>
									<Text text="-" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
									<Input
										id="odometerTo"
										type="Number"
										placeholder="{i18n>vehicleAgeToPlaceholder}"
										width="100%">
						<layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
					</Input>
								</HBox>
							</fb:control>
						</fb:FilterGroupItem>
					</fb:filterGroupItems>
					</fb:FilterBar>
				</Panel>
			</f:DynamicPageHeader>
		</f:header>

		<!-- Main content -->
		<f:content>
			<FlexBox direction="Column" fitContainer="true" renderType="Bare" width="100%" height="100%">

				<!-- shown while the class data loads (before the table/list appears) -->
				<BusyIndicator id="loadBusy" visible="{= ${ui>/tableBusy} &amp;&amp; !${ui>/showTable} }" class="sapUiMediumMarginTop" />

				<MessageStrip
					id="errorStrip"
					text="{ui>/errorText}"
					type="Error"
					showIcon="true"
					showCloseButton="true"
					visible="{ui>/errorVisible}"
					class="sapUiSmallMarginBottom" />

				<!-- Empty state shown before the first Go -->
				<IllustratedMessage
					id="emptyState"
					visible="{ui>/showEmptyState}"
					illustrationType="sapIllus-Tent"
					title="{i18n>emptyStateTitle}"
					description="{i18n>emptyStateDesc}" />

				<!-- No-results state shown after a Go that returned nothing -->
				<IllustratedMessage
					id="noDataState"
					visible="{ui>/showNoData}"
					illustrationType="sapIllus-NoSearchResults"
					title="{ui>/noDataTitle}"
					description="{i18n>noDataDesc}" />

				<Panel
					id="equipmentReportPanel"
					headerText="{ui>/tableTitle}"
					visible="{ui>/showTable}"
					expandable="true"
					expanded="false"
					expand="onTableScroll"
					height="100%"
					width="100%">
					<OverflowToolbar>
						<Text id="pageInfo" text="{ui>/pageInfo}" />
						<Button id="retryLoadMore" text="{i18n>retryLoadMore}" visible="{ui>/loadMoreFailed}" press="onRetryLoadMore" />
						<ToolbarSpacer />
						<Button id="expandAllBtn" text="{= ${ui>/treeExpandedAll} ? ${i18n>collapseAllButton} : ${i18n>expandAllButton} }" press="onExpandAll" />
						<Switch id="showEmptySwitch" state="{ui>/showEmpty}" change="onShowEmptyChange" />
						<Label text="{i18n>showEmpty}" />
						<Button id="exportBtn" icon="sap-icon://excel-attachment" text="{i18n>exportButton}" tooltip="{i18n>exportButton}" press="onExport" />
					</OverflowToolbar>

				<custom:TopTableScrollbar table="equipmentTreeTable" label="{i18n>topScrollbarLabel}" />
				<table:TreeTable
					id="equipmentTreeTable"
					visible="{ui>/showTable}"
					rows="{path: 'ui>/treeRows', parameters: { arrayNames: ['children'] }}"
					selectionMode="None"
					fixedColumnCount="1"
					enableColumnReordering="true"
					alternateRowColors="true"
					expandFirstLevel="true"
					firstVisibleRowChanged="onTableScroll"
					rowsUpdated="onTableScroll"
					visibleRowCountMode="Auto"
					minAutoRowCount="10"
					height="100%"
					width="100%"
					busy="{ui>/tableBusy}"
					busyIndicatorDelay="0">
					<table:columns>
						<table:Column width="12rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colTechnicalObject}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'TechnicalObject' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'TechnicalObject' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colTechnicalObject}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="TechnicalObject" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>TechnicalObject}" />
							</table:template>
						</table:Column>
						<table:Column width="22rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colTechnicalObjectDescription}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'TechnicalObjectDescription' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'TechnicalObjectDescription' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colTechnicalObjectDescription}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="TechnicalObjectDescription" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>TechnicalObjectDescription}" />
							</table:template>
						</table:Column>
						<table:Column width="9rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colVehicleAge}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'VehicleAge' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'VehicleAge' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colVehicleAge}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="VehicleAge" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>VehicleAge}" />
							</table:template>
						</table:Column>
						<table:Column width="12rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colClass}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'Class' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'Class' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colClass}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="Class" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>Class}" />
							</table:template>
						</table:Column>
						<table:Column width="18rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colSubClassName}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'SubClassName' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'SubClassName' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colSubClassName}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="SubClassName" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>SubClassName}" />
							</table:template>
						</table:Column>
						<table:Column width="18rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colSubClassValue}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'SubClassValue' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'SubClassValue' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colSubClassValue}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="SubClassValue" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>SubClassValue}" />
							</table:template>
						</table:Column>
						<table:Column width="17rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>filterCabinConfig}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'CabinConfiguration' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'CabinConfiguration' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>filterCabinConfig}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="CabinConfiguration" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>CabinConfiguration}" />
							</table:template>
						</table:Column>
						<table:Column width="17rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>filterOwnedBy}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'EquipmentOwnedBy' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'EquipmentOwnedBy' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>filterOwnedBy}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="EquipmentOwnedBy" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>EquipmentOwnedBy}" />
							</table:template>
						</table:Column>
						<table:Column width="16rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>filterOdometer}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'OdometerReading' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'OdometerReading' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>filterOdometer}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="OdometerReading" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>OdometerReading}" />
							</table:template>
						</table:Column>
						<table:Column width="20rem">
							<HBox alignItems="Center" width="100%">
								<Label text="{i18n>colStartUpGeneralData}" />
								<Button press="onSortFieldPress" type="{= ${ui>/sortField} === 'StartUpDate' ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>/sortField} === 'StartUpDate' ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" tooltip="{i18n>colStartUpGeneralData}" class="cfaColumnSortBtn">
									<customData><core:CustomData key="sortKey" value="StartUpDate" /></customData>
								</Button>
							</HBox>
							<table:template>
								<Text text="{ui>StartUpDate}" />
							</table:template>
						</table:Column>
						<table:Column width="24rem">
							<Label text="{i18n>colSerialNoGeneralData}" />
							<table:template>
								<Text text="{ui>ManufacturerSerialNumber}" />
							</table:template>
						</table:Column>
						<table:Column width="22rem">
							<Label text="{i18n>colTechnicalIdGeneralData}" />
							<table:template>
								<Text text="{ui>TechnicalID}" />
							</table:template>
						</table:Column>
					</table:columns>
				</table:TreeTable>
				</Panel>

			</FlexBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
