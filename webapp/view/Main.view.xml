<mvc:View
	controllerName="com.cfa.vehiclelist.controller.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:table="sap.ui.table"
	xmlns:core="sap.ui.core"
	height="100%">

	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false" fitContent="true">

		<!-- Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H2" />
				</f:heading>
				<f:expandedContent>
					<Label text="{i18n>appSubtitle}" />
				</f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>

		<!-- Filter bar lives in the page header -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<fb:FilterBar
					id="filterbar"
					useToolbar="false"
					showFilterConfiguration="false"
					showRestoreButton="false"
					showClearButton="true"
					showGoOnFB="true"
					showClearOnFB="true"
					search="onGoPress"
					clear="onClearPress">
					<fb:filterGroupItems>
						<fb:FilterGroupItem name="class" label="{i18n>filterClass}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<Select
									id="classSelect"
									selectedKey="{ui>/classId}"
									enabled="{ui>/classSelectEnabled}"
									busy="{ui>/classBusy}"
									busyIndicatorDelay="0"
									forceSelection="false"
									change="onClassChange"
									placeholder="{i18n>classPlaceholder}"
									width="100%"
									items="{ path: 'ui>/classes', templateShareable: false }">
									<core:Item key="{ui>ClassInternalID}" text="{ui>__display}" />
								</Select>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charc" label="{i18n>filterSubClassCharc}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="charcSelect"
									width="100%"
									placeholder="{i18n>subClassCharcPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									selectionChange="onSubClassChange"
									items="{ path: 'ui>/charcOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="charcValue" label="{i18n>filterSubClassValue}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="charcValueFilter"
									width="100%"
									busy="{ui>/charcValueBusy}"
									busyIndicatorDelay="0"
									placeholder="{i18n>subClassValuePlaceholder}"
									items="{ path: 'ui>/charcValueOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="cabinConfiguration" label="{i18n>filterCabinConfig}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="cabinConfigFilter"
									placeholder="{i18n>cabinConfigPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									width="100%"
									items="{ path: 'ui>/cabinConfigOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="equipmentOwnedBy" label="{i18n>filterOwnedBy}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox
									id="equipmentOwnedByFilter"
									placeholder="{i18n>ownedByPlaceholder}"
									busy="{ui>/charcBusy}"
									busyIndicatorDelay="0"
									width="100%"
									items="{ path: 'ui>/equipmentOwnedByOptions', templateShareable: false }">
									<core:Item key="{ui>key}" text="{ui>text}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						<fb:FilterGroupItem name="vehicleAge" label="{i18n>filterVehicleAge}" groupName="main" visibleInFilterBar="true">
							<fb:control>
								<HBox alignItems="Center" width="100%">
									<Input
										id="vehicleAgeFrom"
										type="Number"
										placeholder="{i18n>vehicleAgeFromPlaceholder}"
										width="4rem" />
									<Text text="-" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
									<Input
										id="vehicleAgeTo"
										type="Number"
										placeholder="{i18n>vehicleAgeToPlaceholder}"
										width="4rem" />
								</HBox>
							</fb:control>
						</fb:FilterGroupItem>
					</fb:filterGroupItems>
				</fb:FilterBar>
			</f:DynamicPageHeader>
		</f:header>

		<!-- Main content -->
		<f:content>
			<FlexBox direction="Column" fitContainer="true" renderType="Bare" width="100%" height="100%">

				<!-- shown while the class data loads (before the table/list appears) -->
				<BusyIndicator id="loadBusy" visible="{= ${ui>/tableBusy} &amp;&amp; !${ui>/showTable} }" class="sapUiMediumMarginTop" />

				<MessageStrip
					id="errorStrip"
					text="{ui>/errorText}"
					type="Error"
					showIcon="true"
					showCloseButton="true"
					visible="{ui>/errorVisible}"
					class="sapUiSmallMarginBottom" />

				<!-- Empty state shown before the first Go -->
				<IllustratedMessage
					id="emptyState"
					visible="{ui>/showEmptyState}"
					illustrationType="sapIllus-Tent"
					title="{i18n>emptyStateTitle}"
					description="{i18n>emptyStateDesc}" />

				<!-- No-results state shown after a Go that returned nothing -->
				<IllustratedMessage
					id="noDataState"
					visible="{ui>/showNoData}"
					illustrationType="sapIllus-NoSearchResults"
					title="{ui>/noDataTitle}"
					description="{i18n>noDataDesc}" />

				<Panel
					id="equipmentReportPanel"
					headerText="{ui>/tableTitle}"
					visible="{ui>/showTable}"
					expandable="true"
					expanded="false"
					width="100%">
					<OverflowToolbar>
						<Button id="prevPage" icon="sap-icon://navigation-left-arrow" tooltip="{i18n>prevPageButton}" enabled="{ui>/pagePrevEnabled}" press="onPrevPage" />
						<Text id="pageInfo" text="{ui>/pageInfo}" />
						<Button id="nextPage" icon="sap-icon://navigation-right-arrow" tooltip="{i18n>nextPageButton}" enabled="{ui>/pageNextEnabled}" press="onNextPage" />
						<Select id="pageSizeSelect" selectedKey="{ui>/pageSize}" forceSelection="true" autoAdjustWidth="true" tooltip="{i18n>rowsPerPage}" change="onPageSizeChange">
							<core:Item key="25" text="25" />
							<core:Item key="50" text="50" />
							<core:Item key="100" text="100" />
						</Select>
						<ToolbarSpacer />
						<Switch id="showEmptySwitch" state="{ui>/showEmpty}" change="onShowEmptyChange" />
						<Label text="{i18n>showEmpty}" />
						<Button id="exportBtn" icon="sap-icon://excel-attachment" text="{i18n>exportButton}" tooltip="{i18n>exportButton}" press="onExport" />
					</OverflowToolbar>

				<ScrollContainer horizontal="true" vertical="false" width="100%" class="sapUiTinyMarginBottom">
					<FlexBox alignItems="Center" wrap="NoWrap">
						<Label text="{i18n>sortBy}" class="sapUiTinyMarginEnd" />
						<HBox wrap="NoWrap" items="{ path: 'ui>/sortFields', templateShareable: false }">
							<Button text="{ui>label}" press="onSortFieldPress" type="{= ${ui>key} === ${ui>/sortField} ? 'Emphasized' : 'Transparent' }" icon="{= ${ui>key} === ${ui>/sortField} ? (${ui>/sortDesc} ? 'sap-icon://sort-descending' : 'sap-icon://sort-ascending') : 'sap-icon://sort' }" class="sapUiTinyMarginEnd cfaSortBtn" />
						</HBox>
					</FlexBox>
				</ScrollContainer>
				<table:TreeTable
					id="equipmentTreeTable"
					visible="{ui>/showTable}"
					rows="{path: 'ui>/treeRows', parameters: { arrayNames: ['children'] }}"
					selectionMode="None"
					fixedColumnCount="1"
					enableColumnReordering="true"
					alternateRowColors="true"
					expandFirstLevel="true"
					width="100%"
					busy="{ui>/tableBusy}"
					busyIndicatorDelay="0">
					<table:columns>
						<table:Column width="12rem">
							<Label text="{i18n>colTechnicalObject}" />
							<table:template>
								<Text text="{ui>TechnicalObject}" />
							</table:template>
						</table:Column>
						<table:Column width="22rem">
							<Label text="{i18n>colTechnicalObjectDescription}" />
							<table:template>
								<Text text="{ui>TechnicalObjectDescription}" />
							</table:template>
						</table:Column>
						<table:Column width="9rem">
							<Label text="{i18n>colVehicleAge}" />
							<table:template>
								<Text text="{ui>VehicleAge}" />
							</table:template>
						</table:Column>
						<table:Column width="12rem">
							<Label text="{i18n>colClass}" />
							<table:template>
								<Text text="{ui>Class}" />
							</table:template>
						</table:Column>
						<table:Column width="18rem">
							<Label text="{i18n>colSubClassName}" />
							<table:template>
								<Text text="{ui>SubClassName}" />
							</table:template>
						</table:Column>
						<table:Column width="18rem">
							<Label text="{i18n>colSubClassValue}" />
							<table:template>
								<Text text="{ui>SubClassValue}" />
							</table:template>
						</table:Column>
						<table:Column width="17rem">
							<Label text="{i18n>filterCabinConfig}" />
							<table:template>
								<Text text="{ui>CabinConfiguration}" />
							</table:template>
						</table:Column>
						<table:Column width="17rem">
							<Label text="{i18n>filterOwnedBy}" />
							<table:template>
								<Text text="{ui>EquipmentOwnedBy}" />
							</table:template>
						</table:Column>
						<table:Column width="16rem">
							<Label text="{i18n>filterOdometer}" />
							<table:template>
								<Text text="{ui>OdometerReading}" />
							</table:template>
						</table:Column>
						<table:Column width="20rem">
							<Label text="{i18n>colStartUpGeneralData}" />
							<table:template>
								<Text text="{ui>StartUpDate}" />
							</table:template>
						</table:Column>
						<table:Column width="24rem">
							<Label text="{i18n>colSerialNoGeneralData}" />
							<table:template>
								<Text text="{ui>ManufacturerSerialNumber}" />
							</table:template>
						</table:Column>
						<table:Column width="22rem">
							<Label text="{i18n>colTechnicalIdGeneralData}" />
							<table:template>
								<Text text="{ui>TechnicalID}" />
							</table:template>
						</table:Column>
					</table:columns>
				</table:TreeTable>
				</Panel>

			</FlexBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
